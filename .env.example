# Copy this file to .env for local development. Leave database fields blank
# to keep using the local SQLite database.
GRAMSEVA_DB_HOST=
GRAMSEVA_DB_PORT=3306
GRAMSEVA_DB_NAME=
GRAMSEVA_DB_USER=
GRAMSEVA_DB_PASSWORD=

# Set this to the MySQL provider's CA certificate file path.
# Example: GRAMSEVA_DB_SSL_CA=/absolute/path/to/ca.pem
GRAMSEVA_DB_SSL_CA=

# Admin account used for login. The username defaults to "admin".
ADMIN_USERNAME=admin
# Email address assigned to the existing admin account.
ADMIN_EMAIL=
# Required in production. Use a strong, unique password, then run
# `python3 setup_admin.py` to securely hash it into the existing admin record.
# Never expose it to frontend code.
ADMIN_PASSWORD=
