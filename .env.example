# Copy this file to .env for local development. Leave database fields blank
# to keep using the local SQLite database.
GRAMSEVA_DB_HOST=
GRAMSEVA_DB_PORT=3306
GRAMSEVA_DB_NAME=
GRAMSEVA_DB_USER=
GRAMSEVA_DB_PASSWORD=

# Set this to the MySQL provider's CA certificate file path.
# Example: GRAMSEVA_DB_SSL_CA=/absolute/path/to/ca.pem
GRAMSEVA_DB_SSL_CA=
